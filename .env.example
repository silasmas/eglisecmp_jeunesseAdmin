APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL absolue publique (e-mails, billets). Sur hébergement mutualisé avec /public :
# RETRAITE_PUBLIC_BASE_URL=https://jeunesse.eglisecmp.com/public
RETRAITE_PUBLIC_BASE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=Jeunesse@eglisecmp.com
MAIL_FROM_NAME="Jeunesse CMP"
MAIL_EHLO_DOMAIN=jeunesse.eglisecmp.com
RETRAITE_MAIL_REPLY_TO=Jeunesse@eglisecmp.com
RETRAITE_MAIL_REPLY_TO_NAME="Jeunesse CMP"

# Fichiers : s3 (AWS) ou local
FILESYSTEM_DISK=local
# Ne pas mettre s3 ici : uploads navigateur → disque local, puis copie serveur vers S3
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
MEDIA_DISK=media
# true = miniatures thumb/preview en file d'attente (queue:work requis)
MEDIA_GENERATE_CONVERSIONS=false
# Si true : lancer php artisan queue:work (QUEUE_CONNECTION=database ou redis)
# QUEUE_CONVERSIONS_BY_DEFAULT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seed de base (php artisan db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password
# SEED_ADMIN_PASSWORD_HASH=$2y$12$QJUb9FkLyOWINqcI1lS0Nuz8YHVNzFcmRCtGl7l766M0KUCXl.KO6
# SEED_PANEL_USER_EMAIL=
# SEED_PANEL_USER_PASSWORD=password

# Lien GET /system/sync-production-base/{token} et affichage dans l'admin (super_admin)
# PRODUCTION_BASE_SYNC_TOKEN=

KECCEL_TOKEN=
KECCEL_SENDER=DGRAD
KECCEL_SEND_URL=https://api.keccel.com/sms/v2/message.asp
KECCEL_BALANCE_URL=https://api.keccel.com/sms/balance.asp
KECCEL_DELIVERY_URL=https://api.keccel.com/sms/delivery.asp
